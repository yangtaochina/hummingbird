<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Hummingbird.App</RootNamespace>
    <Version>1.7.0</Version>
    <InformationalVersion>1.7.0-guided-production-20261119</InformationalVersion>
    <Product>飞秒创芯</Product>
    <Description>飞秒创芯表盘激光打孔上位机（WinForms 主程序）</Description>
    <!-- 与 Basler.Pylon.dll（x64 + P/Invoke 原生库）保持一致，避免 32/64 位加载失败 -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <!--
    pylon SDK 探测（与 Hummingbird.Devices.Basler.csproj 保持完全一致的路径与顺序）。
    找到 → HAS_PYLON，MainForm 的 Real 模式启用 BaslerCameraService；
    没找到 → Real 模式相机置空（日志提示），Sim 模式不受影响。
  -->
  <PropertyGroup>
    <PylonDll Condition="'$(PylonDll)' == '' and Exists('E:\Program Files\Basler\pylon 7\Development\Assemblies\Basler.Pylon\x64\Basler.Pylon.dll')">E:\Program Files\Basler\pylon 7\Development\Assemblies\Basler.Pylon\x64\Basler.Pylon.dll</PylonDll>
    <PylonDll Condition="'$(PylonDll)' == '' and Exists('C:\Program Files\Basler\pylon 7\Development\Assemblies\Basler.Pylon\x64\Basler.Pylon.dll')">C:\Program Files\Basler\pylon 7\Development\Assemblies\Basler.Pylon\x64\Basler.Pylon.dll</PylonDll>
    <DefineConstants Condition="'$(PylonDll)' != ''">$(DefineConstants);HAS_PYLON</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Hummingbird.SmokeTest\XyEvidenceReview.cs" Link="Analysis\XyEvidenceReview.cs" />
    <Compile Include="..\Hummingbird.SmokeTest\LaserSpotReview.cs" Link="Analysis\LaserSpotReview.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hummingbird.Core\Hummingbird.Core.csproj" />
    <ProjectReference Include="..\Hummingbird.Vision\Hummingbird.Vision.csproj" />
    <ProjectReference Include="..\Hummingbird.Devices.Sim\Hummingbird.Devices.Sim.csproj" />
    <ProjectReference Include="..\Hummingbird.Devices.OpcUa\Hummingbird.Devices.OpcUa.csproj" />
    <ProjectReference Include="..\Hummingbird.Devices.LaserRtu\Hummingbird.Devices.LaserRtu.csproj" />
    <ProjectReference Include="..\Hummingbird.Devices.Basler\Hummingbird.Devices.Basler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <None Update="机床程序\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\视觉兼容性优化_20261119.md" Link="视觉兼容性优化_20261119.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\飞秒创芯_操作说明.md" Link="飞秒创芯_操作说明.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\templates\dial_18holes.json" Link="templates\dial_18holes.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config.example.json" CopyToOutputDirectory="PreserveNewest">
      <TargetPath Condition="!Exists('$(MSBuildProjectDirectory)\config.json')">config.json</TargetPath>
    </None>
  </ItemGroup>

</Project>
