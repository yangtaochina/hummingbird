; HUMMINGBIRD STATION RETURN - NO LASER COMMANDS, NO Z2 MOTION
; R220-R229 EXCLUSIVE; STOP/RESET OTHER NC BEFORE PANEL START
; PANEL START ONLY ARMS; SOFTWARE MUST CONFIRM LASER OFF AND REQUEST
; C USES SHORTEST PATH AT APPROVED CLEARANCE HEIGHT
DEF INT HR_REQ
DEF INT HR_WAIT
DEF REAL HR_DC
G90 G71 G94 G60
STOPRE
R221=0 R222=0 R226=0 R229=0
R225=15712531
R220=10
HR_WAIT=0
HR_WAITING:
STOPRE
G4 F0.1
R223=$AA_IM[X] R224=$AA_IM[Y]
R227=$AA_IM[Z] R228=$AA_IM[C]
HR_WAIT=HR_WAIT+1
IF R226==9 GOTOF HR_STOP
IF HR_WAIT>6000 GOTOF HR_ERROR
IF R221==0 GOTOB HR_WAITING
IF R221<>1 GOTOF HR_ERROR
IF R229<=0 GOTOF HR_ERROR
HR_REQ=R229
IF $AA_IM[X]<(-160.400000) GOTOF HR_ERROR
IF $AA_IM[X]>(-134.000000) GOTOF HR_ERROR
IF $AA_IM[Y]<(-209.600000) GOTOF HR_ERROR
IF $AA_IM[Y]>(-181.700000) GOTOF HR_ERROR
IF $AA_IM[Z]<(-201.883240) GOTOF HR_ERROR
IF $AA_IM[Z]>(-192.168030) GOTOF HR_ERROR
R220=11
SUPA G1 Z=(-192.178030) F30.000
STOPRE
IF ABS($AA_IM[Z]-(-192.178030))>0.010 GOTOF HR_ERROR
IF R226==9 GOTOF HR_STOP
R220=12
SUPA G1 C=DC(254.824500) F60.000
STOPRE
HR_DC=ABS($AA_IM[C]-(254.824500))
WHILE HR_DC>=360
HR_DC=HR_DC-360
ENDWHILE
IF HR_DC>180
HR_DC=360-HR_DC
ENDIF
IF HR_DC>0.005 GOTOF HR_ERROR
IF ABS($AA_IM[Z]-(-192.178030))>0.010 GOTOF HR_ERROR
IF R226==9 GOTOF HR_STOP
R220=13
SUPA G1 X=(-135.027450) Y=(-188.575640) F30.000
STOPRE
IF ABS($AA_IM[X]-(-135.027450))>0.005 GOTOF HR_ERROR
IF ABS($AA_IM[Y]-(-188.575640))>0.005 GOTOF HR_ERROR
IF ABS($AA_IM[Z]-(-192.178030))>0.010 GOTOF HR_ERROR
IF R226==9 GOTOF HR_STOP
R220=14
SUPA G1 Z=(-201.873240) F30.000
STOPRE
IF ABS($AA_IM[X]-(-135.027450))>0.005 GOTOF HR_ERROR
IF ABS($AA_IM[Y]-(-188.575640))>0.005 GOTOF HR_ERROR
IF ABS($AA_IM[Z]-(-201.873240))>0.010 GOTOF HR_ERROR
HR_DC=ABS($AA_IM[C]-(254.824500))
WHILE HR_DC>=360
HR_DC=HR_DC-360
ENDWHILE
IF HR_DC>180
HR_DC=360-HR_DC
ENDIF
IF HR_DC>0.005 GOTOF HR_ERROR
IF R226==9 GOTOF HR_STOP
R223=$AA_IM[X] R224=$AA_IM[Y]
R227=$AA_IM[Z] R228=$AA_IM[C]
R222=HR_REQ
R220=15
M30
HR_STOP:
R220=18
M30
HR_ERROR:
R220=19
M0
M30
