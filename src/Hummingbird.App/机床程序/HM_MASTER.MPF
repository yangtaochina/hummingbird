; HUMMINGBIRD CONTINUOUS XY DISPATCHER - PANEL START ONCE
; RESERVE R220-R229; REVIEW XY ENVELOPE AND FIXED Z/C
; NO LASER OR Z/C MOTION; NO INTERMEDIATE M0 ON NORMAL PATH
DEF INT HM_WAIT
G90 G71 G94 G60
STOPRE
IF ABS($AA_IM[Z]-(-201.873240))>0.010 GOTOF HM_ERROR
R221=0 R222=0 R226=0
R225=161339
R220=1
HM_WAIT=0
HM_LOOP:
STOPRE
G4 F0.1
HM_WAIT=HM_WAIT+1
IF HM_WAIT>6600 GOTOF HM_ERROR
IF R226==9 GOTOF HM_END
IF R221==R222 GOTOB HM_LOOP
IF R221<>R222+1 GOTOF HM_ERROR
R227=R223 R228=R224 R229=R221
IF R227<(-160.400000) GOTOF HM_ERROR
IF R227>(-134.000000) GOTOF HM_ERROR
IF R228<(-209.600000) GOTOF HM_ERROR
IF R228>(-181.700000) GOTOF HM_ERROR
IF ABS($AA_IM[Z]-(-201.873240))>0.010 GOTOF HM_ERROR
R220=2
SUPA G1 X=R227 Y=R228 F30
STOPRE
R222=R229
R220=3
HM_WAIT=0
GOTOB HM_LOOP
HM_ERROR:
R220=9
M0
HM_END:
R220=0
M30
